# Copy to .env and fill in. Never commit .env.
PORT=
MONGODB_URL=
JWT_SECRET=
# Access-token lifetime (default 30m, never more than 1h). Sessions stay alive through the refresh cookie.
ACCESS_TOKEN_TTL=
NODE_ENV=

RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

EMAIL_HOST=
EMAIL_PORT=
EMAIL_SECURE=
EMAIL_USER=
EMAIL_PASSWORD=
EMAIL_FROM=
EMAIL_FROM_NAME=

GEMINI_API_KEY=

# Optional HTTP delivery adapters for OTPs / notifications
SMS_API_URL=
EMAIL_API_URL=

# Secret for the /cron endpoints (bearer token)
CRON_SECRET=

# Testing only. When "true" (and NODE_ENV is not production) OTPs are returned in the API response
# because no SMS/e-mail provider is configured. Leave unset on any deployed server.
OTP_IN_RESPONSE=

# ---- Security (see ../SECURITY.md) ----
# Exact browser origins allowed to call the API, comma separated, https only in production. No wildcards.
ALLOWED_ORIGINS=
FRONTEND_URL=
# Refresh cookie: SameSite=None (default in production, needs https) works when the site and API are on different
# domains; set "lax" or "strict" when both share one registrable domain (more secure). REFRESH_COOKIE_DOMAIN is optional.
REFRESH_COOKIE_SAMESITE=
REFRESH_COOKIE_DOMAIN=
REFRESH_IDLE_DAYS=7
REFRESH_ABSOLUTE_DAYS=30
MAX_SESSIONS_PER_USER=10
# Rate-limit counters: "mongo" (default in production, shared across serverless instances) or "memory"
RATE_LIMIT_STORE=
API_RATE_LIMIT_PER_MIN=600
JSON_BODY_LIMIT=1mb
# Only if the database for "test connection" is on a private network. Leave unset otherwise.
ALLOW_PRIVATE_DB_HOSTS=

# ---- Maintenance mode (see ../SECURITY.md section 5) ----
# Emergency switch: "true" ignores every maintenance window (use if you are locked out, then remove it).
MAINTENANCE_FORCE_OFF=
# How fresh (ms) other server instances keep the maintenance state. Default 5000.
MAINTENANCE_CACHE_TTL_MS=

# Live dashboards (socket.io). Sockets only run on a long-lived Node host, never on Vercel.
# REALTIME_ENABLED=false
# SOCKET_PUBLIC_URL=https://api.example.com
# REDIS_URL=redis://...          # several instances: also npm i @socket.io/redis-adapter redis
# DASHBOARD_CACHE_TTL_MS=20000
# DASHBOARD_POLL_INTERVAL_MS=30000

# ---- Human verification + signup wizard (see ../SECURITY.md section 7) ----
# recaptcha (Google reCAPTCHA v2 "I'm not a robot" checkbox, recommended for production) | turnstile | hcaptcha |
# none (built-in proof-of-work, no keys needed) | off (development only; refused in production)
# For recaptcha create a v2 checkbox key pair at https://www.google.com/recaptcha/admin and add your domain(s).
HUMAN_CHECK_PROVIDER=
# Public site key (also put it in the frontend as NEXT_PUBLIC_HUMAN_CHECK_SITE_KEY if the UI reads it from env)
HUMAN_CHECK_SITE_KEY=
# SECRET key from reCAPTCHA / Turnstile / hCaptcha. Required when the provider is recaptcha, turnstile or hcaptcha. Never commit it.
HUMAN_CHECK_SECRET_KEY=
# Proof-of-work difficulty in bits (12-24, default 18) and failed logins before a login challenge (default 3)
HUMAN_CHECK_POW_BITS=
HUMAN_CHECK_LOGIN_THRESHOLD=
# "true" also requires the human check on the legacy multipart POST /v1/public/register
HUMAN_CHECK_ENFORCE_LEGACY=
